# OpenAI-compatible provider settings.
# Copy to .env for local experiments. Do not commit .env.

OPENAI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_MODE=responses
OPENAI_MODEL_WEAK=gpt-4o-mini
OPENAI_MODEL_STRONG=gpt-4o

# Live API calls must be explicitly unlocked.
ALLOW_LIVE_API=false

# Optional local model paths/names for embedding experiments.
LOCAL_EMBEDDING_MODEL=
