# Copy this file to .env and fill values locally.
# Never commit a real API key.

OPENAI_API_KEY=

# Model routing for Phase 1 proposal pilots.
OPENAI_MODEL_WEAK=
OPENAI_MODEL_STRONG=

# Optional metadata for run manifests.
OPENAI_PROVIDER=mock
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_USER_AGENT=curl/8.19.0

# OpenAI-compatible gateways such as CherryIN/NewAPI often use chat_completions.
# Official GPT-5.x endpoints may use responses. Choose explicitly for live runs.
OPENAI_API_MODE=responses

# Set to true only when you intentionally allow external live API calls
# for proposal-generation experiments. OPENAI_PROVIDER=openai alone is not enough.
ALLOW_LIVE_API=false

LLM_CACHE_POLICY=provider_prompt_cache_if_available

# Optional named provider profiles for redundancy.
# These are placeholders only; do not commit real keys.
#
# Selection:
#   PSML_PROVIDER_DEFAULT is tried first.
#   PSML_PROVIDER_FALLBACK is used only for provider/service failures
#   such as unavailable model, retryable HTTP errors, timeout, or transport failure.
#   It is not used to hide schema/quote/evidence validation failures.
PSML_PROVIDER_DEFAULT=openai_primary
PSML_PROVIDER_FALLBACK=claude_secondary

# Primary OpenAI profile.
PSML_PROVIDER_OPENAI_PRIMARY_PROVIDER=openai
PSML_PROVIDER_OPENAI_PRIMARY_API_KEY=
# Or use indirection instead of storing a key in this file:
# PSML_PROVIDER_OPENAI_PRIMARY_API_KEY_ENV=OPENAI_API_KEY
PSML_PROVIDER_OPENAI_PRIMARY_BASE_URL=https://api.openai.com/v1
PSML_PROVIDER_OPENAI_PRIMARY_API_MODE=responses
PSML_PROVIDER_OPENAI_PRIMARY_WEAK_MODEL=
PSML_PROVIDER_OPENAI_PRIMARY_STRONG_MODEL=
PSML_PROVIDER_OPENAI_PRIMARY_USER_AGENT=curl/8.19.0
PSML_PROVIDER_OPENAI_PRIMARY_MAX_RETRIES=2
PSML_PROVIDER_OPENAI_PRIMARY_RETRY_BASE_SECONDS=1.0
PSML_PROVIDER_OPENAI_PRIMARY_RETRY_MAX_SECONDS=12.0

# Secondary Claude/OpenAI-compatible gateway profile.
PSML_PROVIDER_CLAUDE_SECONDARY_PROVIDER=openai
PSML_PROVIDER_CLAUDE_SECONDARY_API_KEY=
# Or use indirection:
# PSML_PROVIDER_CLAUDE_SECONDARY_API_KEY_ENV=CLAUDE_COMPAT_API_KEY
PSML_PROVIDER_CLAUDE_SECONDARY_BASE_URL=
PSML_PROVIDER_CLAUDE_SECONDARY_API_MODE=chat_completions
PSML_PROVIDER_CLAUDE_SECONDARY_WEAK_MODEL=claude-haiku-4-5
PSML_PROVIDER_CLAUDE_SECONDARY_STRONG_MODEL=claude-haiku-4-5
PSML_PROVIDER_CLAUDE_SECONDARY_USER_AGENT=curl/8.19.0
PSML_PROVIDER_CLAUDE_SECONDARY_MAX_RETRIES=2
PSML_PROVIDER_CLAUDE_SECONDARY_RETRY_BASE_SECONDS=1.0
PSML_PROVIDER_CLAUDE_SECONDARY_RETRY_MAX_SECONDS=12.0
