{
  "schema_version": "external_relation_schema_catalog.v0.3",
  "catalog_id": "graph_v03_external_relation_schema_catalog",
  "purpose": "External relation schema sources used to normalize graph relation candidates. This catalog is a schema reference, not graph truth.",
  "graph_is_not_proof": true,
  "sources": [
    {
      "source_id": "arf_fiction_relation_ontology",
      "name": "ARF / Artificial Relationships in Fiction",
      "url": "https://aclanthology.org/anthology-files/pdf/latechclfl/2025.latechclfl-1.13.pdf",
      "local_artifacts": [
        "external_references/graph_relation_schemas/arf/README.md",
        "external_references/graph_relation_schemas/arf/hf_dataset_api_Despina_project_gutenberg.json",
        "external_references/graph_relation_schemas/arf/synthetic_relations_in_fiction_books_train.parquet",
        "external_references/graph_relation_schemas/arf/arf_relation_schema_summary.json",
        "external_references/graph_relation_schemas/arf/arf_relation_types.txt"
      ],
      "role": "Primary narrative/literary relation schema reference.",
      "used_for": [
        "family relations",
        "social relations",
        "location/presence relations",
        "event participation relations",
        "artifact/content relations"
      ]
    },
    {
      "source_id": "dialogre_relation_schema",
      "name": "DialogRE",
      "url": "https://dataset.org/dialogre/",
      "local_artifacts": [
        "external_references/graph_relation_schemas/dialogre/dialogre",
        "external_references/graph_relation_schemas/dialogre/dialogre_relation_schema_summary.json",
        "external_references/graph_relation_schemas/dialogre/dialogre_relation_types.txt"
      ],
      "role": "Dialogue/social relation schema reference.",
      "used_for": [
        "speaker social relations",
        "family relations in dialogue",
        "visited/place/residence relations",
        "employment/member relations"
      ]
    },
    {
      "source_id": "conceptnet_relations",
      "name": "ConceptNet relations",
      "url": "https://github.com/commonsense/conceptnet5/wiki/relations",
      "local_artifacts": [
        "external_references/graph_relation_schemas/conceptnet/conceptnet5.wiki",
        "external_references/graph_relation_schemas/conceptnet/conceptnet5.wiki/Relations.md"
      ],
      "role": "Commonsense fallback family reference.",
      "used_for": [
        "part_of",
        "located_at",
        "causes",
        "uses",
        "motivates",
        "has_attribute",
        "related_to_generic fallback"
      ]
    },
    {
      "source_id": "dbpedia_wikidata_property_reference",
      "name": "DBpedia Ontology / Wikidata properties",
      "url": "https://www.dbpedia.org/resources/ontology/",
      "local_artifacts": [
        "external_references/graph_relation_schemas/dbpedia/dbpedia_ontology_page.html",
        "external_references/graph_relation_schemas/dbpedia/dbpedia_ontology_tbox.owl",
        "external_references/graph_relation_schemas/wikidata/selected_property_manifest.json",
        "external_references/graph_relation_schemas/wikidata/P26.json",
        "external_references/graph_relation_schemas/wikidata/P22.json",
        "external_references/graph_relation_schemas/wikidata/P25.json",
        "external_references/graph_relation_schemas/wikidata/P40.json",
        "external_references/graph_relation_schemas/wikidata/P551.json",
        "external_references/graph_relation_schemas/wikidata/P463.json",
        "external_references/graph_relation_schemas/wikidata/P527.json",
        "external_references/graph_relation_schemas/wikidata/P361.json",
        "external_references/graph_relation_schemas/wikidata/P276.json"
      ],
      "role": "Encyclopedic alias reference for common person/place/property edges.",
      "used_for": [
        "spouse",
        "child",
        "parent",
        "birth/place/residence",
        "member_of",
        "part_of"
      ]
    }
  ],
